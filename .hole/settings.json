{
  "$schema": "https://raw.githubusercontent.com/lukashornych/hole/main/assets/schema/settings.schema.json",
  "hooks": {
    "setup": [{
      "script": ".hole/setup.sh"
    }]
  },
  "environment": {
    "OSS_PROJECT_PATH": "$OSS_PROJECT_PATH"
  },
  "libraries": {
    "$OSS_PROJECT_PATH/evita/evitaDB": {
      "path": "$OSS_PROJECT_PATH/evita/evitaDB",
      "readwrite": true
    },
    "$OSS_PROJECT_PATH/evita/evitaDB-dev": {
      "path": "$OSS_PROJECT_PATH/evita/evitaDB-dev",
      "readwrite": true
    },
    "$OSS_PROJECT_PATH/evita/codemirror-lang-evitaql": {
      "path": "$OSS_PROJECT_PATH/evita/codemirror-lang-evitaql",
      "readwrite": true
    }
  },
  "files": {
    "include": {
      "$OSS_PROJECT_PATH/evita/evitaDB/data": "/evita-data"
    },
    "exclude": [
      "node_modules"
    ]
  },
  "network": {
    "allow": [
      "mcp.context7.com",
      "registry-1.docker.io",
      "*.docker.io",
      "*.cloudflare.docker.com",
      "production.cloudfront.docker.com",
      "mcp-proxy.anthropic.com",
      "registry.npmjs.org",
      "*.github.com",
      "raw.githubusercontent.com",
      "evitadb.io",
      "demo.evitadb.io",
      "registry.yarnpkg.com"
    ]
  }
}