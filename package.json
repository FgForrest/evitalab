{
  "name": "evitalab",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev-driver": "env VITE_RUN_MODE=\"DRIVER\" vite",
    "dev:demo": "env VITE_DEV_CONNECTION=\"DEMO\" vite",
    "dev:local": "env VITE_DEV_CONNECTION=\"LOCAL\" vite",
